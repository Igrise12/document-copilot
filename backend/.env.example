# Supabase: Dashboard → Project Settings → API
# Database: Dashboard → Project Settings → Database → Connection string

# --- Supabase (Auth + API) ---

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# --- Postgres (Alembic + direct DB access) ---

# Use the DIRECT connection (host: db.<ref>.supabase.co).
# Do NOT use the transaction pooler URL (pooler.supabase.com) — migrations require a session connection.
# URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# --- Ollama (local LLM + embeddings) ---

OLLAMA_BASE_URL=http://127.0.0.1:7869
# Build this profile first: ollama create document-copilot:16k -f Modelfile
OLLAMA_CHAT_MODEL=document-copilot:16k
OLLAMA_EMBEDDING_MODEL=embeddinggemma:latest
OLLAMA_EMBEDDING_DIMENSIONS=768
# UTF-8-byte budget for stored source chunks. Embedding input is separately bounded below.
INGESTION_CHUNK_MAX_BYTES=4096
OLLAMA_EMBEDDING_MAX_INPUT_BYTES=2048
OLLAMA_EMBEDDING_BATCH_SIZE=16
OLLAMA_TIMEOUT_SECONDS=120
CHAT_HISTORY_MESSAGE_LIMIT=12
CHAT_MAX_OUTPUT_TOKENS=1024
CHAT_PROMPT_MAX_BYTES=10000
CHAT_TURN_TIMEOUT_SECONDS=180
SIGNED_URL_TTL_SECONDS=600

# --- Retrieval ---

RETRIEVAL_SEMANTIC_CANDIDATE_LIMIT=20
RETRIEVAL_LEXICAL_CANDIDATE_LIMIT=20
RETRIEVAL_RESULT_LIMIT=8
RETRIEVAL_RRF_K=60
RETRIEVAL_SEMANTIC_WEIGHT=1
RETRIEVAL_LEXICAL_WEIGHT=1

# --- Access and uploads ---

# Domain only, without the @ symbol.
ALLOWED_EMAIL_DOMAIN=driftwoodcapital.com
MAX_UPLOAD_BYTES=52428800
ALLOWED_UPLOAD_MEDIA_TYPES=application/pdf

# --- Server ---

# Comma-separated browser origins allowed to call the API (CORS).
ALLOWED_ORIGINS=http://localhost:5173
